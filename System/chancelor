#!/bin/sh

#set -o xtrace

# mytempo directory
MYTEMPO_DATA=
DATABASE_DIR="$MYTEMPO_DATA"/database
BACKUP_DIR="$DATABASE_DIR"/backup
ENVIO_DIR="$DATABASE_DIR"/envio
LOG_DIR="$DATABASE_DIR"/logs

AUTO_UPLOAD_INTERVAL=240  # auto-upload every 4 minutes (in seconds)
AUTO_UPLOAD_PID=""
AUTO_UPLOAD_ENABLED=1
UPLOAD_LOCK="$DATABASE_DIR/upload.lock"

not_empty() {

	[ "$(ls -A "$1")" ]
}

mytempo_upload() {

	"$MYTEMPO_DATA"/Online/setup.online "$(realpath "$1")" upload

	# does not find any fatal errors
	! jq -c 'select(.level == "error").msg | contains("fatal")' "$LOG_DIR/pc.log" | grep -q "true"
}

mytempo_update() {

	"$MYTEMPO_DATA"/Online/setup.online "$DATABASE_DIR" update 2>"$LOG_DIR/pc.log"

	# zero receival errors?
	[ -z "$(jq -c "select(.error)" "$LOG_DIR/pc.log")" ]
}

mytempo_validate() {

	"$MYTEMPO_DATA"/Online/validate.online "$(realpath "$1")"

	# does not find any fatal errors
	! jq -c 'select(.level == "error").msg | contains("fatal")' "$LOG_DIR/pc.log" | grep -q "true"
}

mytempo_save() {

	# moves all database files to directory specified by $1, which
	# will be created, along with its parents, if it doesn't exist

	mkdir -p "$1" && mv "$DATABASE_DIR"/N*.db "$1"
}

mytempo_backup_to() {

	# $1 -> envio/backup, destination for the backup file to be created
	# the database files will be put in a directory named "DAY.MONTH.YEAR-HOUR_MINUTE.(envio/backup)"
	# under the specified destination.

	mytempo_save "$DATABASE_DIR"/"$1"/"$(date +"%d.%m.%Y-%H_%M").$1"
}

mytempo_move_envio_to_backup() {

	not_empty "$ENVIO_DIR" &&
		mv "$ENVIO_DIR"/* "$BACKUP_DIR"
}

mytempo_upload_dir() {

	directory="$DATABASE_DIR/$1"
	not_empty "$directory" &&
		for d in "$directory"/*; do
			cp "$DATABASE_DIR"/equipamento.db "$d" &&
				{
					mytempo_upload "$d" ||
						break
				}
		done 2>>"$LOG_DIR/pc.log"
}

mytempo_validate_dir() {

	directory="$DATABASE_DIR/$1"
	not_empty "$directory" &&
		for d in "$directory"/*; do
			cp "$DATABASE_DIR"/equipamento.db "$d" &&
				{
					mytempo_validate "$d" ||
						break
				}
		done 2>>"$LOG_DIR/pc.log"
}

mytempo_toggle_autoupload() {

	if [ "$AUTO_UPLOAD_ENABLED" = 1 ]; then
		AUTO_UPLOAD_ENABLED=0
		echo "[AUTO-UPLOAD] Auto-upload disabled"
	else
		AUTO_UPLOAD_ENABLED=1
		echo "[AUTO-UPLOAD] Auto-upload enabled"
	fi
}

mytempo_upload_normal() {

	mytempo_move_envio_to_backup

	mytempo_update &&
		mytempo_upload_dir backup
}

mytempo_upload_validation() {

	mytempo_update &&
		mytempo_move_envio_to_backup &&
		mytempo_validate_dir backup
}

mytempo_acquire_upload_lock() {
	mkdir "$UPLOAD_LOCK" 2>/dev/null
}

mytempo_release_upload_lock() {
	rmdir "$UPLOAD_LOCK" 2>/dev/null
}

mytempo_auto_upload_once() {

	LIVE_SNAPSHOT="$ENVIO_DIR/auto_upload_live"

	# clean up any previous leftover snapshot
	rm -rf "$LIVE_SNAPSHOT" 2>/dev/null

	# copy live databases to envio so they get uploaded too
	if ls "$DATABASE_DIR"/N*.db 1>/dev/null 2>&1; then
		mkdir -p "$LIVE_SNAPSHOT"
		cp "$DATABASE_DIR"/N*.db "$LIVE_SNAPSHOT"
	fi

	# skip if nothing to upload in any directory
	if ! not_empty "$BACKUP_DIR" && ! not_empty "$ENVIO_DIR"; then
		return 0
	fi

	if mytempo_acquire_upload_lock; then
		echo "[AUTO-UPLOAD] Starting automatic upload cycle"
		{
			mytempo_update &&
				mytempo_upload_dir backup &&
				mytempo_upload_dir envio
		} || true
		mytempo_release_upload_lock
		echo "[AUTO-UPLOAD] Cycle complete"
	else
		echo "[AUTO-UPLOAD] Skipped: upload already in progress"
	fi

	rm -rf "$LIVE_SNAPSHOT" 2>/dev/null
}

mytempo_start_auto_upload() {

	if [ "$AUTO_UPLOAD_ENABLED" != 1 ]; then
		echo "[AUTO-UPLOAD] Auto-upload is disabled, skipping"
		return 0
	fi

	(
		while true; do
			sleep "$AUTO_UPLOAD_INTERVAL"
			mytempo_auto_upload_once
		done
	) &
	AUTO_UPLOAD_PID=$!
	echo "[AUTO-UPLOAD] Started background uploads every ${AUTO_UPLOAD_INTERVAL}s (PID $AUTO_UPLOAD_PID)"
}

mytempo_stop_auto_upload() {

	if [ -n "$AUTO_UPLOAD_PID" ]; then
		kill "$AUTO_UPLOAD_PID" 2>/dev/null
		wait "$AUTO_UPLOAD_PID" 2>/dev/null
		AUTO_UPLOAD_PID=""
		echo "[AUTO-UPLOAD] Stopped background uploads"
	fi

	# clean up any in-flight upload containers
	docker rm -f reenvio receba 2>/dev/null || true

	mytempo_release_upload_lock
}

mytempo_dump_db() {

	SQL_QUERY="${2:-select athlete_num, athlete_time, antenna from athletes_times}"

	TODAY=$(date +"%m/%d/%Y")

	for i in "$1"/N*.db; do
		sqlite3 -list -separator "," "$i" "$SQL_QUERY"
	done | perl -ne '
		chomp;
		@F = split(/,/);

		$num = $F[0];
		$tme = $F[1];
		$ant = $F[2];
		$day = "'"$TODAY"'"; # faster
		chomp($day);

		$npre = "0" x (16 - length($num));
		$apre = "0" x (3 - length($ant));

		print "$apre$ant$npre$num$tme$day;$npre$num;$tme\n";' 2>/dev/null
}

mytempo_dump_all() {

	echo "This may take a while..."

	not_empty "$BACKUP_DIR" &&
		for d in "$BACKUP_DIR"/*; do
			mytempo_dump_db "$d" "$1" >/tmp/"dump$(basename "$d")"
		done

	not_empty "$ENVIO_DIR" &&
		for d in "$ENVIO_DIR"/*; do
			mytempo_dump_db "$d" "$1" >/tmp/"dump$(basename "$d")"
		done
}

mytempo_usb_save() {

	rm -f /tmp/dump*

	mount /dev/sdb1 /mnt &&
		(
			mytempo_dump_all &&
				cat /tmp/dump* |
				awk 'NF {print $0}' >/mnt/MYTEMPO_"$(date +"%H_%M_%S")".txt \
				;
			umount /mnt
		)
}

mytempo_usb_save_stats() {

	mytempo_usb_save

	rm -f /tmp/dump*

	mount /dev/sdb1 /mnt &&
		(
			mytempo_dump_all "select athlete_num, MIN(athlete_time), antenna from athletes_times group by athlete_num" &&
				cat /tmp/dump* |
				awk 'NF {print $0}' >/mnt/MYTEMPO_"$(date +"%H_%M_%S")"_TAGS_UNICAS.txt \
				;
			cp /tmp/*.log /mnt/ &&
				cp /tmp/*.err /mnt/ &&
				cp "$DATABASE_DIR"/TAGS /mnt/ \
				;
			umount /mnt
		)
}

mytempo_clean() {

	# XXX
	not_empty "${BACKUP_DIR:?}" &&
		rm -rf "${BACKUP_DIR:?}"/*

	not_empty "${ENVIO_DIR:?}" &&
		rm -rf "${ENVIO_DIR:?}"/*

	rm "$DATABASE_DIR"/TAGS
}

mytempo_count_tags_dir() {

	# trivia: what is my tech stack? PAWS, Python AWk and Shell script

	python -c "print(sum([$( (for i in "$1"/N*.db; do sqlite3 -line "$i" "select COUNT(1) from athletes_times"; done) | awk 'NF {print $3","}')]))"
}

mytempo_count_tags() {

	count=0

	# pipe all output of this to /dev/null, since we just want
	# the side effect.

	not_empty "$ENVIO_DIR" &&
		for d in "$ENVIO_DIR"/*; do
			count=$(($(mytempo_count_tags_dir "$d") + "$count"))
		done 1>/dev/null 2>/dev/null && echo $count
}

mytempo_populate_tags() {

	test -e "$DATABASE_DIR"/TAGS && rm "$DATABASE_DIR"/TAGS

	not_empty "$ENVIO_DIR" &&
		for d in "$ENVIO_DIR"/*; do
			not_empty "$d" &&
			for i in "$d"/N*.db; do
				sqlite3 -line "$i" "select distinct athlete_num from athletes_times"
			done
		done 2>/dev/null | awk 'NF {print $3}' >"$DATABASE_DIR"/TAGS
}

mytempo_do_update() {

	cd "$MYTEMPO_DATA" || exit
	git pull
	./install no_manual_setup
	reboot
}

echo "Chancelor, Version 1.2.0"

trap 'mytempo_stop_auto_upload' EXIT INT TERM

echo "Backing up leftover data (if any)"
test -e "$DATABASE_DIR"/N0.db &&
	mytempo_backup_to backup

mytempo_move_envio_to_backup

VERSION_NUMBER_AA2=$(cd "$MYTEMPO_DATA" && git rev-list --count HEAD)
export VERSION_NUMBER_AA2

# clean up logs
echo '{"level":"info","msg":"No data"}' >"$LOG_DIR"/pc.log

while true; do
	rm "$DATABASE_DIR"/*-journal
	rm "$DATABASE_DIR"/equipamento.db

	# set initial value of tag count
	TAG_COUNT_START_AT=$(mytempo_count_tags)
	export TAG_COUNT_START_AT
    export AUTO_UPLOAD_ENABLED

	echo "Booting version #${VERSION_NUMBER_AA2:-0}"

	mytempo_populate_tags

	"$MYTEMPO_DATA"/Offline/setup.offline

	mytempo_start_auto_upload

	# wait for a signal
	read -r UPLOAD_TYPE <"$DATABASE_DIR"/sig-upload-data

	mytempo_stop_auto_upload

	"$MYTEMPO_DATA"/Offline/stop.offline

	mytempo_backup_to envio

	# clean up logs
	echo '{"level":"info","msg":"No data"}' >"$LOG_DIR"/pc.log

	echo "[OPERATION: '$UPLOAD_TYPE', TIMESTAMP: '$(date +%s)']" >>"$LOG_DIR"/operation.log

	case "$UPLOAD_TYPE" in
	"fatal"   )                           ;;
	"reboot"  )                    reboot ;;
	"poweroff")              shutdown now ;;
	"reset"   ) mytempo_clean             ;;
	"update"  ) mytempo_do_update         ;;
	"normal"  ) mytempo_upload_normal     ;;
	"stats"   ) mytempo_usb_save_stats    ;;
    "auto_up" ) mytempo_toggle_autoupload ;;
	"validate") mytempo_upload_validation ;;
	esac

	sleep 5
done
