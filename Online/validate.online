#!/bin/sh

env_file="$(dirname "$0")"/../shared.env

# if no custom directory is specified, set default
database=$1

docker run --network=host --add-host=tts.docker:172.17.0.1 --env-file="$env_file" -v "$database":/var/monotempo-data --name validate "validate:1.0"
docker wait validate
docker remove validate
