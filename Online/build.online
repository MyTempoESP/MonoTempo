#!/bin/sh

error() {
	exit 1
}

dir=$(realpath "$(dirname "$0")")

export DOCKER_BUILDKIT=1

cd "$dir"/Receba || error
docker build --network=host --tag="receba:1.0" . || error

cd "$dir"/Reenvio || error
docker build --network=host --tag="reenvio:1.0" . || error

cd "$dir"/Validate || error
docker build --network=host --tag="validate:1.0" . || error
